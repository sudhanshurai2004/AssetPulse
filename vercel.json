{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "api": {
      "root": "backend",
      "entrypoint": "Dockerfile"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/actuator/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/swagger-ui.html",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/swagger-ui/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/v3/api-docs",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/v3/api-docs/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
